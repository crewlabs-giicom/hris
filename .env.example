# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hris

# JWT secrets — generate long random strings for real environments
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated API keys for consumer apps (Backbone, Ticketing).
# In production these should be generated per-client and stored hashed
# in the api_clients table, not read from env directly — this is a
# placeholder for local development only.
CONSUMER_API_KEYS=
